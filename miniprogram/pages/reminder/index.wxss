.reminder-page {
  padding-bottom: 60rpx;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.row-title {
  display: block;
  font-size: 29rpx;
  color: var(--color-text);
}

.row-desc {
  display: block;
  font-size: 23rpx;
  color: var(--color-text-tertiary);
  margin-top: 6rpx;
}

.divider {
  height: 1rpx;
  background: var(--color-border);
  margin: 24rpx 0;
}

.picker.mini {
  height: 68rpx;
  line-height: 68rpx;
  padding: 0 24rpx;
  background: var(--color-bg);
  border-radius: 10rpx;
  font-size: 26rpx;
}

/* ---------- 优先级图示 ---------- */
.priority-desc {
  display: block;
  font-size: 23rpx;
  color: var(--color-text-tertiary);
  margin-bottom: 20rpx;
}

.priority-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.priority-row:last-child {
  border-bottom: none;
}

.priority-order {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--color-bg);
  color: var(--color-text-secondary);
  font-size: 24rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.priority-body {
  flex: 1;
}

.priority-cond {
  display: block;
  font-size: 27rpx;
  color: var(--color-text);
}

.priority-note {
  display: block;
  font-size: 21rpx;
  color: var(--color-text-tertiary);
  margin-top: 4rpx;
}

.priority-result {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 100rpx;
  flex-shrink: 0;
}

.result-silent {
  background: #fff1f0;
  color: #a3202b;
}

.result-notify {
  background: #e8f5ec;
  color: #146c2e;
}

/* ---------- 添加行 ---------- */
.add-row {
  display: flex;
  align-items: center;
}

.flex1 {
  flex: 1;
}

.add-btn {
  width: 150rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.dash {
  margin: 0 12rpx;
  color: var(--color-text-tertiary);
}

.time-picker {
  width: 170rpx;
  text-align: center;
  padding: 0;
}

/* ---------- chips ---------- */
.chip-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.chip {
  display: flex;
  align-items: center;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: 24rpx;
  padding: 10rpx 18rpx;
  border-radius: 100rpx;
  margin: 0 16rpx 16rpx 0;
}

.chip-x {
  margin-left: 12rpx;
  font-size: 28rpx;
  line-height: 1;
}

.hint {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-top: 16rpx;
}

/* ---------- 课程行 ---------- */
.course-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.course-row-name {
  font-size: 28rpx;
  color: var(--color-text);
}

/* ---------- 演示 ---------- */
.demo-actions {
  display: flex;
  margin-top: 20rpx;
}

.demo-btn {
  flex: 1;
  margin: 0 8rpx;
  font-size: 25rpx;
}

.demo-result {
  margin-top: 24rpx;
  background: var(--color-bg);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: var(--color-text);
  line-height: 1.6;
}
