.reminder-page {
  padding-bottom: 60rpx;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.row-title {
  display: block;
  font-size: 29rpx;
  color: var(--color-text);
}

.row-desc {
  display: block;
  font-size: 23rpx;
  color: var(--color-text-tertiary);
  margin-top: 6rpx;
}

.divider {
  height: 1rpx;
  background: var(--color-border);
  margin: 24rpx 0;
}

.picker.mini {
  height: 68rpx;
  line-height: 68rpx;
  padding: 0 24rpx;
  background: var(--color-bg);
  border-radius: 10rpx;
  font-size: 26rpx;
}

/* ---------- 优先级图示 ---------- */
.priority-desc {
  display: block;
  font-size: 23rpx;
  color: var(--color-text-tertiary);
  margin-bottom: 20rpx;
}

.priority-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.priority-row:last-child {
  border-bottom: none;
}

.priority-order {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--color-bg);
  color: var(--color-text-secondary);
  font-size: 24rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.priority-body {
  flex: 1;
}

.priority-cond {
  display: block;
  font-size: 27rpx;
  color: var(--color-text);
}

.priority-note {
  display: block;
  font-size: 21rpx;
  color: var(--color-text-tertiary);
  margin-top: 4rpx;
}

.priority-result {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 100rpx;
  flex-shrink: 0;
}

.result-silent {
  background: #fff1f0;
  color: #a3202b;
}

.result-notify {
  background: #e8f5ec;
  color: #146c2e;
}

/* ---------- 添加行 ---------- */
.add-row {
  display: flex;
  align-items: center;
}

.flex1 {
  flex: 1;
}

.add-btn {
  width: 150rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.dash {
  margin: 0 12rpx;
  color: var(--color-text-tertiary);
}

.time-picker {
  width: 170rpx;
  text-align: center;
  padding: 0;
}

/* ---------- chips ---------- */
.chip-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.chip {
  display: flex;
  align-items: center;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: 24rpx;
  padding: 10rpx 18rpx;
  border-radius: 100rpx;
  margin: 0 16rpx 16rpx 0;
}

.chip-x {
  margin-left: 12rpx;
  font-size: 28rpx;
  line-height: 1;
}

.hint {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-top: 16rpx;
}

/* ---------- 课程行 ---------- */
.course-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.course-row-main {
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
}

.course-row-name {
  display: block;
  font-size: 28rpx;
  color: var(--color-text);
}

.course-row-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.sync-result {
  margin-top: 20rpx;
  padding: 20rpx;
  background: var(--color-surface-alt, #f5f6f8);
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--color-text-secondary);
  white-space: pre-wrap;
}

.sync-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 12rpx;
}

.sync-row .hint {
  flex: 1;
  margin-top: 0;
}

.link-btn {
  flex-shrink: 0;
  padding: 8rpx 4rpx;
  font-size: 24rpx;
  color: var(--color-primary);
}

/* ---------- 订阅日历 ---------- */
.feed-box {
  margin-top: 20rpx;
  padding: 20rpx;
  background: var(--color-surface-alt, #f5f6f8);
  border-radius: 12rpx;
}

/* 当前订阅的课表名：切课表会让订阅内容整份变，必须让用户看得见 */
.feed-meta {
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--color-border-tertiary, rgba(0, 0, 0, 0.08));
}

.feed-meta-label {
  display: inline-block;
  margin-right: 12rpx;
  padding: 4rpx 16rpx;
  background: var(--color-primary);
  color: #fff;
  border-radius: 999rpx;
  font-size: 22rpx;
  vertical-align: middle;
}

.feed-meta-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
  vertical-align: middle;
}

.feed-meta .hint {
  display: block;
  margin-top: 12rpx;
}

.feed-url {
  display: block;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--color-text-secondary);
  word-break: break-all;
}

.feed-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.btn-mini {
  padding: 12rpx 32rpx;
  background: var(--color-primary);
  color: #fff;
  border-radius: 999rpx;
  font-size: 26rpx;
}

.feed-guide-toggle {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--color-primary);
}

.feed-guide {
  margin-top: 12rpx;
  padding-left: 8rpx;
  border-left: 4rpx solid var(--color-border-tertiary, rgba(0, 0, 0, 0.08));
}

.feed-guide text {
  display: block;
  font-size: 24rpx;
  line-height: 1.8;
  color: var(--color-text-secondary);
}

/* 清理说明里的小标题，把「订阅的」和「直接写入的」两组步骤分开 */
.feed-guide .guide-title {
  margin-top: 16rpx;
  font-weight: 600;
  color: var(--color-text);
}

.feed-guide .guide-title:first-child {
  margin-top: 0;
}

/* ---------- 演示 ---------- */
.demo-actions {
  display: flex;
  margin-top: 20rpx;
}

.demo-btn {
  flex: 1;
  margin: 0 8rpx;
  font-size: 25rpx;
}

.demo-result {
  margin-top: 24rpx;
  background: var(--color-bg);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: var(--color-text);
  line-height: 1.6;
}

/* ---------- 节假日表 ---------- */
.holiday-meta {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
}

.holiday-source {
  flex: 1;
}

.holiday-updated {
  margin-right: 16rpx;
  color: var(--color-text-tertiary);
}

/* 用 --color-bg 而不是 --color-surface-alt：后者是深色模式分支才引入的变量，
   在 master 基线上未定义，会静默回退到浅灰、深色下变白块 */
.holiday-list {
  background: var(--color-bg);
  border-radius: 12rpx;
  padding: 8rpx 20rpx;
  margin-bottom: 16rpx;
}

.holiday-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  font-size: 26rpx;
}

.holiday-row + .holiday-row {
  border-top: 1rpx solid var(--color-border);
}

.holiday-name {
  color: var(--color-text);
}

.holiday-range {
  color: var(--color-text-tertiary);
  font-size: 24rpx;
}

.holiday-none {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  padding: 20rpx 0;
  margin-bottom: 16rpx;
}

/* 深色模式覆盖：提醒判定结果的两态徽章（静音红 / 提醒绿） */
@media (prefers-color-scheme: dark) {
  .result-silent {
    color: #ff8a8a;
    background: #3d1a1a;
  }

  .result-notify {
    color: #5fd08a;
    background: #14301f;
  }
}
