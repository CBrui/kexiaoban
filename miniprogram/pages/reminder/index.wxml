<view class="page reminder-page">

  <!-- 全局开关与提前量 -->
  <view class="card">
    <view class="row-between">
      <view>
        <text class="row-title">全局提醒</text>
        <text class="row-desc">关闭后所有提醒静默</text>
      </view>
      <switch checked="{{config.globalMute}}" color="#f53f3f" bindchange="onToggleMute" />
    </view>

    <view class="divider"></view>

    <view class="row-between">
      <view>
        <text class="row-title">提前提醒时间</text>
        <text class="row-desc">上课前多久推送</text>
      </view>
      <picker mode="selector" range="{{leadOptions}}" value="{{leadIndex}}" bindchange="onPickLead">
        <view class="picker mini">{{config.leadMinutes}} 分钟</view>
      </picker>
    </view>
  </view>

  <!-- 优先级图示（答辩重点） -->
  <view class="card">
    <view class="section-title">不提醒判定优先级</view>
    <text class="priority-desc">命中即返回，顺序不可调换。用户能看到「为什么今天没提醒」。</text>
    <view class="priority-list">
      <view class="priority-row" wx:for="{{priorityRows}}" wx:key="order">
        <view class="priority-order">{{item.order}}</view>
        <view class="priority-body">
          <text class="priority-cond">{{item.cond}}</text>
          <text wx:if="{{item.note}}" class="priority-note">{{item.note}}</text>
        </view>
        <view class="priority-result {{item.result === '不提醒' ? 'result-silent' : 'result-notify'}}">
          {{item.result}}
        </view>
      </view>
    </view>
  </view>

  <!-- 自定义不提醒日期 -->
  <view class="card">
    <view class="section-title">不提醒日期</view>
    <view class="add-row">
      <picker mode="date" value="{{newDate}}" bindchange="onNewDateChange">
        <view class="picker flex1">{{newDate || '选择日期'}}</view>
      </picker>
      <view class="btn btn-ghost add-btn" bindtap="onAddSilentDate">添加</view>
    </view>
    <view wx:if="{{config.silentDates.length}}" class="chip-list">
      <view class="chip" wx:for="{{config.silentDates}}" wx:key="index">
        <text>{{item}}</text>
        <text class="chip-x" data-idx="{{index}}" bindtap="onRemoveSilentDate">×</text>
      </view>
    </view>
    <text wx:else class="hint">如考试周、个人请假日期</text>
  </view>

  <!-- 免打扰时段 -->
  <view class="card">
    <view class="section-title">免打扰时段</view>
    <view class="add-row">
      <picker mode="time" value="{{newRangeFrom}}" bindchange="onFromChange">
        <view class="picker time-picker">{{newRangeFrom}}</view>
      </picker>
      <text class="dash">—</text>
      <picker mode="time" value="{{newRangeTo}}" bindchange="onToChange">
        <view class="picker time-picker">{{newRangeTo}}</view>
      </picker>
      <view class="btn btn-ghost add-btn" bindtap="onAddSilentRange">添加</view>
    </view>
    <view wx:if="{{config.silentRanges.length}}" class="chip-list">
      <view class="chip" wx:for="{{config.silentRanges}}" wx:key="index">
        <text>{{item.from}} - {{item.to}}</text>
        <text class="chip-x" data-idx="{{index}}" bindtap="onRemoveSilentRange">×</text>
      </view>
    </view>
    <text wx:else class="hint">如午休 12:00-14:00</text>
  </view>

  <!-- 单课程静默 -->
  <view class="card">
    <view class="section-title">单课程提醒开关</view>
    <view wx:if="{{courses.length}}">
      <view class="course-row" wx:for="{{courses}}" wx:key="id">
        <view class="course-row-main">
          <text class="course-row-name">{{item.name}}</text>
          <text wx:if="{{item.slotText}}" class="course-row-sub">{{item.slotText}}</text>
        </view>
        <!-- checked 必须用 JS 预算好的 item.muted：
             WXML 数据绑定不支持方法调用，写在模板里的 indexOf 不会生效 -->
        <switch
          checked="{{item.muted}}"
          color="#3a7afe"
          data-id="{{item.id}}"
          bindchange="onToggleCourseMute"
        />
      </view>
      <text class="hint">开启 = 该课程静音</text>
    </view>
    <text wx:else class="hint">还没有课程，先去建表</text>
  </view>

  <!-- 订阅日历：推荐通道。日历主动来拉 .ics，不受安卓「一次只吃 1~2 条」的限制 -->
  <view class="card">
    <view class="section-title">订阅日历（推荐）</view>
    <text class="priority-desc">
      一次订阅，整学期全部节次进手机日历。改课后刷新订阅即生效，不用手动删旧事件。
    </text>
    <view class="btn btn-primary submit-btn {{feedLoading ? 'btn-disabled' : ''}}" bindtap="onGetFeedUrl">
      {{feedLoading ? '生成中…' : (feedUrl ? '重新获取链接' : '获取订阅链接')}}
    </view>

    <view wx:if="{{feedUrl}}" class="feed-box">
      <!-- 订阅的是「当前课表」，切课表内容会整份换，必须写明是哪张 -->
      <view wx:if="{{feedTimetableName}}" class="feed-meta">
        <text class="feed-meta-label">当前订阅</text>
        <text class="feed-meta-name">{{feedTimetableName}} · {{feedCourseCount}} 门课</text>
        <text class="hint">
          订阅的是「当前课表」。切换课表后刷新日历，内容会整份换成新课表；
          日历里的课程数应与此处的 {{feedCourseCount}} 一致，对不上就是漏了。
        </text>
      </view>
      <text class="feed-url" user-select="true">{{feedUrl}}</text>
      <view class="feed-actions">
        <view class="btn btn-mini" bindtap="onCopyFeedUrl">复制链接</view>
        <text class="link-btn" bindtap="onResetFeedUrl">重新生成</text>
      </view>
    </view>

    <view wx:if="{{feedError}}" class="sync-result">{{feedError}}</view>

    <view class="feed-guide-toggle" bindtap="onToggleFeedGuide">
      <text>{{feedGuideOpen ? '收起订阅教程' : '怎么添加到手机日历？'}}</text>
    </view>
    <view wx:if="{{feedGuideOpen}}" class="feed-guide">
      <text>1. 先点上面的「复制链接」</text>
      <text>2. iPhone：设置 → 日历 → 账户 → 添加订阅日历，粘贴链接</text>
      <text>3. 华为：日历 → 设置 → 账户 → 其他日历 → 通过网址导入</text>
      <text>4. 小米：日历 → 右上角 + → 订阅日历</text>
      <text>5. 其他安卓：装 Outlook 或 Google 日历，走「从网络订阅」</text>
      <text class="hint">
        订阅不是实时的：改课后 iOS 隔一阵自动刷新，急的话在日历 App 里手动刷新一次。
      </text>
    </view>
  </view>

  <!-- 同步到手机日历：小程序没有本地通知能力，课前要真的响只能借这条通道 -->
  <view class="card">
    <view class="section-title">直接写入手机日历（备用）</view>
    <text class="priority-desc">
      小程序退到后台后没法自己弹通知。把课写进手机自带日历，由日历 App 到点响铃。
    </text>
    <view class="btn btn-primary submit-btn {{syncing ? 'btn-disabled' : ''}}" bindtap="onSyncCalendar">
      {{syncing ? '同步中…' : '一键同步到系统日历'}}
    </view>
    <view wx:if="{{syncResult}}" class="sync-result">{{syncResult}}</view>
    <view wx:if="{{syncedCount}}" class="sync-row">
      <text class="hint">本地已记录 {{syncedCount}} 条，重复同步会自动跳过</text>
      <text class="link-btn" bindtap="onClearSyncRecord">清空记录</text>
    </view>
    <text class="hint">
      已静音的课不会写入 · 已上完的课自动跳过 · 微信不支持删除日历事件，改课后请在手机日历里删除旧事件再重新同步
    </text>

    <view class="feed-guide-toggle" bindtap="onToggleCleanGuide">
      <text>{{cleanGuideOpen ? '收起清理说明' : '日历里已经导入的怎么删除？'}}</text>
    </view>
    <view wx:if="{{cleanGuideOpen}}" class="feed-guide">
      <text class="guide-title">订阅来的整份课表 —— 删订阅账户，一次清空</text>
      <text>· iPhone：设置 → 日历 → 账户 → 已订阅日历 → 删除账户</text>
      <text>· 华为：日历 → 设置 → 账户 → 找到订阅的 → 删除</text>
      <text>· 小米：日历 → 设置 → 日历账户 → 删除</text>
      <text>· Google 日历：设置 → 该日历 → 取消订阅</text>

      <text class="guide-title">直接写入的散落事件 —— 微信删不掉，只能手动</text>
      <text>· 日历里搜索课程名，把搜到的全找出来</text>
      <text>· 打开事件 → 编辑 → 删除</text>
      <text class="hint">
        ⚠️ 重复事件一定要选「删除所有重复事件」，逐条删删不完。
        建议只保留订阅那份：直接写入的残留会和订阅内容重复提醒两次。
      </text>
    </view>
  </view>

  <!-- 判定演示 -->
  <view class="card">
    <view class="section-title">判定演示</view>
    <text class="priority-desc">点击验证边界场景的判定结果</text>
    <view class="demo-actions">
      <view class="btn btn-ghost demo-btn" bindtap="onDemo">法定节假日场景</view>
      <view class="btn btn-ghost demo-btn" bindtap="onDemoMakeup">调休补课场景</view>
    </view>
    <view wx:if="{{demoResult}}" class="demo-result">{{demoResult}}</view>
  </view>

</view>
