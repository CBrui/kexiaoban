.timetable-page {
  padding: 0;
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
}

/* ---------- 错误条 ---------- */
.error-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 20rpx 24rpx 0;
  padding: 20rpx 24rpx;
  background: #fff1f0;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #a3202b;
}

.error-retry {
  color: var(--color-primary);
  padding: 0 16rpx;
  min-height: 60rpx;
  line-height: 60rpx;
}

/* ---------- 空数据引导 ---------- */
.empty-title {
  display: block;
  font-size: 32rpx;
  color: var(--color-text);
  margin-bottom: 12rpx;
}

.empty-desc {
  display: block;
  color: var(--color-text-tertiary);
  font-size: 26rpx;
  margin-bottom: 32rpx;
}

.empty-btn {
  width: 300rpx;
  margin: 0 auto;
}

/* ---------- 网格容器 ---------- */
.grid-wrap {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding: 16rpx 12rpx 20rpx;
  box-sizing: border-box;
}

/* ---------- 表头 ---------- */
.grid-header {
  display: flex;
  align-items: stretch;
  padding-bottom: 8rpx;
}

/* 左上角角格 */
.corner-cell {
  width: 108rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--color-primary);
  border-radius: 10rpx;
  padding: 8rpx 0;
  min-height: 72rpx;
}

.corner-hover {
  opacity: 0.8;
}

.corner-week {
  font-size: 24rpx;
  font-weight: 500;
  color: #ffffff;
  line-height: 1.2;
}

.corner-parity {
  font-size: 19rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.2;
  margin-top: 2rpx;
}

.day-head {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.day-name {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.2;
}

.day-date {
  font-size: 18rpx;
  color: var(--color-text-tertiary);
  line-height: 1.2;
  margin-top: 2rpx;
  transform: scale(0.95);
}

/* ---------- 主体 ---------- */
.grid-body {
  flex: 1;
  min-height: 0;
  display: flex;
  align-items: flex-start;
  overflow: hidden;
}

/* 节次列：显示 序号 + 起止时间（分两行，适配窄列） */
.slot-col {
  width: 108rpx;
  flex-shrink: 0;
  position: relative;
  z-index: 2;
  background: var(--color-bg);
}

.slot-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.slot-no {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
  line-height: 1.1;
}

.slot-range {
  font-size: 17rpx;
  color: var(--color-text-tertiary);
  line-height: 1.25;
  transform: scale(0.92);
}

/* 休息分隔行（节次列） */
.slot-break {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e8eaed;
  border-radius: 6rpx;
  margin: 2rpx 0;
}

.slot-break-label {
  font-size: 18rpx;
  color: var(--color-text-tertiary);
}

/* ---------- 滑动视口 ---------- */
.swipe-viewport {
  flex: 1;
  overflow: hidden;
  position: relative;
}

/*
 * 可滑动内容层
 * transform 由 JS 控制；拖动中关闭 transition 保证跟手，
 * 松手后开启 transition 产生回弹 / 切页动画。
 */
.day-cols {
  display: flex;
  will-change: transform;
}

.day-cols-animate {
  transition: transform 0.22s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.day-col {
  flex: 1;
  min-width: 0;
  border-left: 1rpx solid var(--color-border);
}

/* 课程格子：高度与节次行保持一致 */
.grid-cell {
  border-bottom: 1rpx solid var(--color-border);
  box-sizing: border-box;
  padding: 2rpx;
}

.break-cell {
  background: #e8eaed;
  border-bottom: 1rpx solid var(--color-border);
  box-sizing: border-box;
  margin: 2rpx 0;
}

.course-block {
  border-radius: 8rpx;
  border-left: 6rpx solid transparent;
  padding: 8rpx 8rpx;
  box-sizing: border-box;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.course-name {
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.3;
  word-break: break-all;
}

.course-loc {
  font-size: 18rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
  line-height: 1.3;
}

/* ---------- 底部 ---------- */
.grid-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 8rpx 0;
}

.swipe-hint {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
}

.footer-link {
  font-size: 22rpx;
  color: var(--color-primary);
  padding: 8rpx 16rpx;
}

/* ---------- 通用遮罩 ---------- */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

/* ---------- 周次选择面板 ---------- */
.week-panel {
  width: 640rpx;
  max-height: 76vh;
  background: var(--color-surface);
  border-radius: 20rpx;
  padding: 32rpx 28rpx 28rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.week-panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.week-panel-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--color-text);
}

.week-panel-close {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  padding: 8rpx 16rpx;
}

.week-panel-scroll {
  flex: 1;
  max-height: 56vh;
}

.week-panel-grid {
  display: flex;
  flex-wrap: wrap;
}

.week-chip {
  width: calc(20% - 16rpx);
  margin: 8rpx;
  height: 96rpx;
  border-radius: 12rpx;
  background: var(--color-bg);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.week-chip-no {
  font-size: 28rpx;
  color: var(--color-text);
  font-weight: 500;
  line-height: 1.2;
}

.week-chip-parity {
  font-size: 19rpx;
  color: var(--color-text-tertiary);
  line-height: 1.2;
  margin-top: 2rpx;
}

.week-chip-active {
  background: var(--color-primary);
}

.week-chip-active .week-chip-no,
.week-chip-active .week-chip-parity {
  color: #ffffff;
}

/* ---------- 课程详情卡片 ---------- */
.detail-card {
  width: 600rpx;
  background: var(--color-surface);
  border-radius: 20rpx;
  padding: 36rpx 32rpx 24rpx;
  box-sizing: border-box;
}

.detail-head {
  border-left: 8rpx solid transparent;
  padding-left: 16rpx;
  margin-bottom: 28rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.detail-name {
  font-size: 36rpx;
  font-weight: 500;
}

.detail-source {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.detail-row {
  display: flex;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.detail-label {
  width: 110rpx;
  color: var(--color-text-tertiary);
  font-size: 26rpx;
  flex-shrink: 0;
}

.detail-value {
  flex: 1;
  font-size: 26rpx;
  color: var(--color-text);
}

.detail-actions {
  display: flex;
  margin-top: 32rpx;
}

.detail-btn {
  flex: 1;
  margin: 0 8rpx;
}

.detail-btn-danger {
  background: #fff1f0;
  color: var(--color-danger);
}
