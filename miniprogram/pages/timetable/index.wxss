.timetable-page {
  padding: 0;
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
}

/* ---------- 错误条 ---------- */
.error-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 20rpx 24rpx 0;
  padding: 20rpx 24rpx;
  background: #fff1f0;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #a3202b;
}

.error-retry {
  color: var(--color-primary);
  padding: 0 16rpx;
  min-height: 60rpx;
  line-height: 60rpx;
}

/* ---------- 空数据引导 ---------- */
.empty-title {
  display: block;
  font-size: 32rpx;
  color: var(--color-text);
  margin-bottom: 12rpx;
}

.empty-desc {
  display: block;
  color: var(--color-text-tertiary);
  font-size: 26rpx;
  margin-bottom: 32rpx;
}

.empty-btn {
  width: 300rpx;
  margin: 0 auto;
}

/* ---------- 网格容器 ---------- */
.grid-wrap {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding: 16rpx 12rpx 20rpx;
  box-sizing: border-box;
}

/* ---------- 表头 ---------- */
.grid-header {
  display: flex;
  align-items: stretch;
  padding-bottom: 8rpx;
}

/*
 * 表头滑动区：宽度 = 内容区 - 角格，与下方 .swipe-viewport 等宽，
 * 因此两条轨道可以用同一个 trackPct 位移，星期表头与课程网格严格同步。
 */
.header-swipe {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  display: flex;
}

.header-track {
  flex: 0 0 100%;
  display: flex;
  will-change: transform;
}

.header-panel {
  flex: 0 0 100%;
  display: flex;
}

/* 左上角角格 */
.corner-cell {
  width: 108rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--color-primary);
  border-radius: 10rpx;
  padding: 8rpx 0;
  min-height: 72rpx;
}

.corner-hover {
  opacity: 0.8;
}

/* 当前查看的不是本周时，角格降饱和，提示「你没在看本周」 */
.corner-off {
  background: var(--color-text-tertiary);
  opacity: 0.75;
}

.corner-week {
  font-size: 24rpx;
  font-weight: 500;
  color: #ffffff;
  line-height: 1.2;
}

.corner-parity {
  font-size: 19rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.2;
  margin-top: 2rpx;
}

.day-head {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;
  padding: 4rpx 0;
  position: relative;
}

/* 今天：表头整体高亮 */
.day-head-today {
  background: var(--color-primary-soft);
}

.day-name {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.2;
}

.day-name-today {
  color: var(--color-primary);
  font-weight: 600;
}

.day-date {
  font-size: 18rpx;
  color: var(--color-text-tertiary);
  line-height: 1.2;
  margin-top: 2rpx;
  transform: scale(0.95);
}

.day-date-today {
  color: var(--color-primary);
  opacity: 0.85;
}

/* 今天下方的圆点标记 */
.day-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--color-primary);
  margin-top: 2rpx;
}

/* ---------- 主体 ---------- */
.grid-body {
  flex: 1;
  min-height: 0;
  display: flex;
  align-items: flex-start;
  overflow: hidden;
}

/* 节次列：显示 序号 + 起止时间（分两行，适配窄列） */
.slot-col {
  width: 108rpx;
  flex-shrink: 0;
  position: relative;
  z-index: 2;
  background: var(--color-bg);
}

.slot-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.slot-no {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
  line-height: 1.1;
}

.slot-range {
  font-size: 17rpx;
  color: var(--color-text-tertiary);
  line-height: 1.25;
  transform: scale(0.92);
}

/* 休息分隔行（节次列） */
.slot-break {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e8eaed;
  border-radius: 6rpx;
  margin: 2rpx 0;
}

.slot-break-label {
  font-size: 18rpx;
  color: var(--color-text-tertiary);
}

/* ---------- 滑动视口 ---------- */
.swipe-viewport {
  flex: 1;
  overflow: hidden;
  position: relative;
}

/*
 * 主体滑动轨道：并排的「上一周 / 本周 / 下一周」三个面板。
 *
 * 轨道宽度 = 一个面板宽度（子元素 flex: 0 0 100% 会溢出而不撑宽容器），
 * 所以 translateX(-100%) 恰好移动一个面板 —— 位移用百分比表达，
 * 与视口的像素宽度无关，无需等待测量即可精确对齐。
 *
 * transform 由 JS 控制；拖动中关闭 transition 保证跟手，
 * 松手后开启 transition 产生回弹 / 切页动画。
 */
.body-track {
  flex: 0 0 100%;
  display: flex;
  will-change: transform;
}

/* 周面板：一周的 7 列；position: relative 作为当前时间指示线的定位基准
   注意：类名必须与「周次选择面板」的 .week-panel 区分，否则会被后者的
   flex-direction: column 等规则覆盖，导致 7 天被竖排、只看得见周一。 */
.track-panel {
  flex: 0 0 100%;
  display: flex;
  position: relative;
}

/* 切页 / 回弹过渡；时长需与 JS 的 TRANSITION_MS(240ms) 保持一致 */
.track-animate {
  transition: transform 0.24s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.day-col {
  flex: 1;
  min-width: 0;
  border-left: 1rpx solid var(--color-border);
}

/* 今天所在列：淡色背景，一眼看出在哪一列 */
.day-col-today {
  background: var(--color-primary-soft);
}

/* ---------- 当前时间指示线 ---------- */
.now-line {
  position: absolute;
  width: calc(100% / 7);
  height: 0;
  z-index: 6;
  pointer-events: none;
}

.now-line-bar {
  height: 2rpx;
  background: var(--color-primary);
  width: 100%;
}

.now-line-flag {
  position: absolute;
  right: 4rpx;
  top: -26rpx;
  background: var(--color-primary);
  color: #ffffff;
  font-size: 17rpx;
  line-height: 1;
  padding: 4rpx 8rpx;
  border-radius: 6rpx;
  white-space: nowrap;
}

/* 课程格子：高度与节次行保持一致 */
.grid-cell {
  border-bottom: 1rpx solid var(--color-border);
  box-sizing: border-box;
  padding: 2rpx;
}

.break-cell {
  background: #e8eaed;
  border-bottom: 1rpx solid var(--color-border);
  box-sizing: border-box;
  margin: 2rpx 0;
}

.course-block {
  border-radius: 8rpx;
  border-left: 6rpx solid transparent;
  padding: 8rpx 8rpx;
  box-sizing: border-box;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.course-name {
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.3;
  word-break: break-all;
}

.course-loc {
  font-size: 18rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
  line-height: 1.3;
}

/* ---------- 底部 ---------- */
.grid-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 8rpx 0;
  min-height: 64rpx;
}

.footer-left {
  display: flex;
  align-items: center;
  min-width: 0;
}

.now-hint {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
}

/* 「回到今天」：仅在查看非本周时出现（条件渲染），避免常驻干扰 */
.footer-btn {
  flex-shrink: 0;
  line-height: 1.2;
}

.footer-btn-today {
  font-size: 24rpx;
  color: #ffffff;
  background: var(--color-primary);
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  box-shadow: 0 2rpx 8rpx rgba(58, 122, 254, 0.28);
}

.footer-btn-hover {
  opacity: 0.85;
  transform: scale(0.97);
}

/* ---------- 通用遮罩 ---------- */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

/* ---------- 周次选择面板 ---------- */
.week-panel {
  width: 640rpx;
  max-height: 76vh;
  background: var(--color-surface);
  border-radius: 20rpx;
  padding: 32rpx 28rpx 28rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.week-panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.week-panel-head-right {
  display: flex;
  align-items: center;
}

.week-panel-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--color-text);
}

.week-panel-today {
  font-size: 24rpx;
  color: var(--color-primary);
  padding: 8rpx 16rpx;
}

.week-panel-close {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  padding: 8rpx 16rpx;
}

.week-panel-scroll {
  flex: 1;
  max-height: 56vh;
}

.week-panel-grid {
  display: flex;
  flex-wrap: wrap;
}

.week-chip {
  width: calc(20% - 16rpx);
  margin: 8rpx;
  height: 106rpx;
  border-radius: 12rpx;
  background: var(--color-bg);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  position: relative;
}

.week-chip-no {
  font-size: 28rpx;
  color: var(--color-text);
  font-weight: 500;
  line-height: 1.2;
}

.week-chip-parity {
  font-size: 19rpx;
  color: var(--color-text-tertiary);
  line-height: 1.2;
  margin-top: 2rpx;
}

/* 本周：描边提示，与「当前选中」区分开 */
.week-chip-today {
  border: 2rpx solid var(--color-primary);
}

.week-chip-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  font-size: 16rpx;
  line-height: 1;
  color: #ffffff;
  background: var(--color-primary);
  padding: 4rpx 6rpx;
  border-radius: 8rpx;
  transform: scale(0.9);
}

.week-chip-active {
  background: var(--color-primary);
}

.week-chip-active .week-chip-no,
.week-chip-active .week-chip-parity {
  color: #ffffff;
}

.week-chip-active.week-chip-today {
  border-color: var(--color-primary);
}

/* ---------- 课程详情卡片 ---------- */
.detail-card {
  width: 600rpx;
  background: var(--color-surface);
  border-radius: 20rpx;
  padding: 36rpx 32rpx 24rpx;
  box-sizing: border-box;
}

.detail-head {
  border-left: 8rpx solid transparent;
  padding-left: 16rpx;
  margin-bottom: 28rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.detail-name {
  font-size: 36rpx;
  font-weight: 500;
}

.detail-source {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.detail-row {
  display: flex;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.detail-label {
  width: 110rpx;
  color: var(--color-text-tertiary);
  font-size: 26rpx;
  flex-shrink: 0;
}

.detail-value {
  flex: 1;
  font-size: 26rpx;
  color: var(--color-text);
}

.detail-actions {
  display: flex;
  margin-top: 32rpx;
}

.detail-btn {
  flex: 1;
  margin: 0 8rpx;
}

.detail-btn-danger {
  background: #fff1f0;
  color: var(--color-danger);
}
