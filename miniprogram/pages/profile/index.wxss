.profile-page {
  padding-bottom: 60rpx;
}

/* ---------- 用户卡片 ---------- */
.user-card {
  display: flex;
  align-items: center;
}

.avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.user-name {
  display: block;
  font-size: 34rpx;
  font-weight: 500;
  color: var(--color-text);
}

.user-sub {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  margin-top: 8rpx;
}

/* ---------- 邀请码 ---------- */
.invite-row {
  display: flex;
  align-items: center;
}

.invite-code {
  flex: 1;
  font-size: 48rpx;
  font-weight: 500;
  letter-spacing: 12rpx;
  color: var(--color-primary);
}

.copy-btn {
  width: 160rpx;
  flex-shrink: 0;
}

.hint {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-top: 16rpx;
}

/* ---------- 统计 ---------- */
.stat-row {
  display: flex;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 500;
  color: var(--color-text);
}

.stat-label {
  font-size: 23rpx;
  color: var(--color-text-tertiary);
  margin-top: 6rpx;
}

/* ---------- 资料 ---------- */
.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.edit-toggle {
  font-size: 26rpx;
  color: var(--color-primary);
  padding: 8rpx 16rpx;
}

.edit-area {
  margin-top: 24rpx;
}

.field {
  margin-bottom: 24rpx;
}

.label {
  display: block;
  font-size: 25rpx;
  color: var(--color-text-secondary);
  margin-bottom: 10rpx;
}

.input {
  height: 80rpx;
  line-height: 80rpx;
  background: var(--color-bg);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.info-list {
  margin-top: 20rpx;
}

.info-row {
  display: flex;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  width: 130rpx;
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  flex-shrink: 0;
}

.info-value {
  flex: 1;
  font-size: 26rpx;
  color: var(--color-text);
}

/* ---------- 菜单 ---------- */
.menu-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.menu-row:last-child {
  border-bottom: none;
}

.menu-text {
  font-size: 29rpx;
  color: var(--color-text);
}

.menu-danger {
  color: var(--color-danger);
}

.menu-arrow {
  font-size: 36rpx;
  color: var(--color-text-tertiary);
  line-height: 1;
}
