<view class="page tm-page">

  <!-- 说明 -->
  <view class="card intro-card">
    <text class="intro-title">多张课表，各自独立</text>
    <text class="intro-desc">每张课表有自己的开课日期与总周次。课表页展示的是「当前课表」，课程也只属于创建它的那张课表。</text>
  </view>

  <!-- 课表列表 -->
  <view wx:if="{{loading}}" class="empty-tip">加载中…</view>

  <block wx:else>
    <view
      wx:for="{{list}}"
      wx:key="id"
      class="card tt-card {{item.isCurrent ? 'tt-card-current' : ''}}"
    >
      <!-- 展示态 -->
      <block wx:if="{{editingId !== item.id}}">
        <view class="tt-head">
          <view class="tt-head-left">
            <view class="tt-name-row">
              <text class="tt-name">{{item.name}}</text>
              <text wx:if="{{item.isCurrent}}" class="tt-tag">当前</text>
            </view>
            <text class="tt-meta">共 {{item.totalWeeks}} 周 · {{item.rangeText}}</text>
            <text class="tt-meta">开课日期 {{item.termStartMonday}} · {{item.courseCount}} 门课程</text>
          </view>
        </view>

        <view class="tt-actions">
          <view
            wx:if="{{!item.isCurrent}}"
            class="tt-btn tt-btn-primary"
            data-id="{{item.id}}"
            bindtap="onSetCurrent"
            hover-class="tt-btn-hover"
          >切为当前</view>
          <view
            wx:else
            class="tt-btn tt-btn-disabled"
          >当前使用中</view>

          <view
            class="tt-btn tt-btn-ghost"
            data-id="{{item.id}}"
            bindtap="onOpenEdit"
            hover-class="tt-btn-hover"
          >编辑</view>

          <view
            wx:if="{{list.length > 1}}"
            class="tt-btn tt-btn-danger"
            data-id="{{item.id}}"
            bindtap="onDelete"
            hover-class="tt-btn-hover"
          >删除</view>
        </view>
      </block>

      <!-- 编辑态 -->
      <block wx:else>
        <view class="field">
          <text class="label">课表名称</text>
          <input class="input" value="{{editForm.name}}" bindinput="onEditName" placeholder="如 2026 秋 主修" />
        </view>
        <view class="field">
          <text class="label">开课日期（第 1 周周一）</text>
          <picker mode="date" value="{{editForm.date}}" start="2000-01-01" end="{{maxDate}}" bindchange="onEditDate">
            <view class="picker">{{editForm.date}}</view>
          </picker>
        </view>
        <view class="field">
          <text class="label">总周次</text>
          <picker mode="selector" range="{{weekOptions}}" value="{{editForm.weeksIndex}}" bindchange="onEditWeeks">
            <view class="picker">{{weekOptions[editForm.weeksIndex]}}</view>
          </picker>
        </view>
        <view class="tt-actions">
          <view class="tt-btn tt-btn-ghost" bindtap="onCancelEdit" hover-class="tt-btn-hover">取消</view>
          <view class="tt-btn tt-btn-primary" bindtap="onSaveEdit" hover-class="tt-btn-hover">保存</view>
        </view>
      </block>
    </view>

    <!-- 新建课表按钮 -->
    <view class="btn btn-primary create-btn" bindtap="onOpenCreate" hover-class="btn-hover">＋ 新建课表</view>
  </block>

  <!-- 新建表单弹层 -->
  <view wx:if="{{showCreate}}" class="mask" bindtap="onCloseCreate">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <text class="sheet-title">新建课表</text>
        <text class="sheet-close" bindtap="onCloseCreate">关闭</text>
      </view>

      <view class="field">
        <text class="label">课表名称</text>
        <input class="input" value="{{createForm.name}}" bindinput="onInputName" placeholder="如 2026 秋 主修" />
      </view>
      <view class="field">
        <text class="label">开课日期（第 1 周周一）</text>
        <picker mode="date" value="{{createForm.date}}" start="2000-01-01" end="{{maxDate}}" bindchange="onPickDate">
          <view class="picker">{{createForm.date}}</view>
        </picker>
      </view>
      <view class="field">
        <text class="label">总周次</text>
        <picker mode="selector" range="{{weekOptions}}" value="{{createForm.weeksIndex}}" bindchange="onPickWeeks">
          <view class="picker">{{weekOptions[createForm.weeksIndex]}}</view>
        </picker>
      </view>

      <view class="sheet-actions">
        <view class="btn btn-ghost sheet-btn" bindtap="onCloseCreate" hover-class="btn-hover">取消</view>
        <view class="btn btn-primary sheet-btn" bindtap="onCreate" hover-class="btn-hover">创建</view>
      </view>
    </view>
  </view>

</view>
