.tm-page {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

/* ---------- 说明 ---------- */
.intro-card {
  background: var(--color-primary-soft);
}

.intro-title {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-primary);
  margin-bottom: 12rpx;
}

.intro-desc {
  display: block;
  font-size: 25rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

/* ---------- 课表卡片 ---------- */
.tt-card-current {
  border: 2rpx solid var(--color-primary);
}

.tt-head {
  display: flex;
  align-items: flex-start;
}

.tt-head-left {
  flex: 1;
  min-width: 0;
}

.tt-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.tt-name {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tt-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #ffffff;
  background: var(--color-primary);
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
  margin-left: 12rpx;
  line-height: 1.6;
}

.tt-meta {
  display: block;
  font-size: 23rpx;
  color: var(--color-text-tertiary);
  line-height: 1.7;
}

/* ---------- 卡片内操作 ---------- */
.tt-actions {
  display: flex;
  margin-top: 24rpx;
}

.tt-btn {
  flex: 1;
  min-height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: var(--radius-md);
  font-size: 27rpx;
  margin-right: 16rpx;
}

.tt-btn:last-child {
  margin-right: 0;
}

.tt-btn-hover {
  opacity: 0.75;
}

.tt-btn-primary {
  background: var(--color-primary);
  color: #ffffff;
}

.tt-btn-ghost {
  background: var(--color-surface);
  color: var(--color-primary);
  border: 1rpx solid var(--color-primary);
}

.tt-btn-disabled {
  background: var(--color-bg);
  color: var(--color-text-tertiary);
}

.tt-btn-danger {
  background: var(--color-surface);
  color: var(--color-danger);
  border: 1rpx solid var(--color-danger);
}

/* ---------- 表单字段 ---------- */
.field {
  margin-bottom: 24rpx;
}

.label {
  display: block;
  font-size: 25rpx;
  color: var(--color-text-secondary);
  margin-bottom: 10rpx;
}

.input {
  height: 80rpx;
  line-height: 80rpx;
  background: var(--color-bg);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.picker {
  height: 80rpx;
  line-height: 80rpx;
  background: var(--color-bg);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--color-text);
}

/* ---------- 新建入口 ---------- */
.create-btn {
  margin-top: 8rpx;
}

.btn-hover {
  opacity: 0.85;
}

/* ---------- 弹层 ---------- */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 50;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: var(--color-surface);
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--color-text);
}

.sheet-close {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  padding: 8rpx 16rpx;
}

.sheet-actions {
  display: flex;
  margin-top: 8rpx;
}

.sheet-btn {
  flex: 1;
  margin: 0 10rpx;
}
