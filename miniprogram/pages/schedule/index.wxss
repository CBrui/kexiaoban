.schedule-page {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

/* ---------- 说明卡 ---------- */
.intro-title {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-text);
  margin-bottom: 12rpx;
}

.intro-desc {
  display: block;
  font-size: 25rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

/* ---------- 分段 ---------- */
.seg-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.seg-label {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--color-text);
}

.seg-counter {
  display: flex;
  align-items: center;
}

.counter-btn {
  width: 68rpx;
  height: 68rpx;
  line-height: 64rpx;
  text-align: center;
  background: var(--color-bg);
  border-radius: 12rpx;
  font-size: 36rpx;
  color: var(--color-text);
  flex-shrink: 0;
}

.btn-hover {
  opacity: 0.6;
}

.counter-input {
  width: 90rpx;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  font-size: 30rpx;
  margin: 0 12rpx;
  color: var(--color-text);
}

.counter-unit {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-left: 10rpx;
}

.seg-row {
  display: flex;
}

.seg-field {
  flex: 1;
  margin-right: 20rpx;
}

.seg-field:last-child {
  margin-right: 0;
}

.field-label {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  margin-bottom: 10rpx;
}

.picker-mini {
  height: 76rpx;
  line-height: 76rpx;
  background: var(--color-bg);
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 27rpx;
  color: var(--color-text);
}

/* ---------- 课间 ---------- */
.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.row-title {
  display: block;
  font-size: 29rpx;
  color: var(--color-text);
}

.row-desc {
  display: block;
  font-size: 23rpx;
  color: var(--color-text-tertiary);
  margin-top: 6rpx;
}

.inline-input {
  display: flex;
  align-items: center;
}

.mini-input {
  width: 110rpx;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  background: var(--color-bg);
  border-radius: 12rpx;
  font-size: 28rpx;
}

/* ---------- 超界提示 ---------- */
.overflow-tip {
  background: #fff1f0;
  border-radius: 16rpx;
  padding: 26rpx;
  margin-bottom: 24rpx;
}

.overflow-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #a3202b;
  margin-bottom: 10rpx;
}

.overflow-desc {
  display: block;
  font-size: 24rpx;
  color: #a3202b;
  opacity: 0.85;
  margin-bottom: 16rpx;
}

.overflow-item {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  font-size: 25rpx;
  color: #791f1f;
  padding: 10rpx 0;
  border-top: 1rpx solid rgba(163, 32, 43, 0.15);
}

.overflow-meta {
  font-size: 22rpx;
  opacity: 0.8;
}

/* ---------- 预览 ---------- */
.preview-grid {
  display: flex;
  flex-wrap: wrap;
}

.preview-item {
  width: calc(25% - 12rpx);
  margin: 6rpx;
  padding: 12rpx 0;
  background: var(--color-bg);
  border-radius: 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.preview-no {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--color-text);
  line-height: 1.2;
}

.preview-time {
  font-size: 17rpx;
  color: var(--color-text-tertiary);
  line-height: 1.3;
  margin-top: 4rpx;
  transform: scale(0.94);
}

.hint {
  display: block;
  font-size: 23rpx;
  color: var(--color-text-tertiary);
  margin-top: 16rpx;
}

/* ---------- 操作 ---------- */
.actions {
  display: flex;
  margin-top: 12rpx;
}

.action-btn {
  flex: 1;
  margin: 0 10rpx;
}
