.match-page {
  padding-bottom: 60rpx;
}

.code-row {
  display: flex;
  align-items: center;
}

.code-input {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--color-bg);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  letter-spacing: 6rpx;
  text-transform: uppercase;
  box-sizing: border-box;
}

.align-btn {
  width: 220rpx;
  margin-left: 20rpx;
  flex-shrink: 0;
}

.range-row {
  display: flex;
  margin-top: 28rpx;
}

.range-item {
  flex: 1;
  margin-right: 20rpx;
}

.range-item:last-child {
  margin-right: 0;
}

.range-label {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 10rpx;
}

.picker.small {
  height: 76rpx;
  line-height: 76rpx;
  font-size: 26rpx;
}

.hint {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-top: 20rpx;
}

/* ---------- 兜底提示 ---------- */
.tip-box {
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.tip-empty {
  background: #fff7e8;
}

.tip-none {
  background: #eef3ff;
}

.tip-error {
  background: #fff1f0;
}

.tip-text {
  display: block;
  font-size: 27rpx;
  color: var(--color-text);
  line-height: 1.6;
}

.tip-action {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--color-primary);
  min-height: 60rpx;
  line-height: 60rpx;
}

/* ---------- 结果区 ---------- */
.week-group {
  margin-bottom: 28rpx;
}

.week-group-head {
  margin-bottom: 14rpx;
}

.week-badge {
  display: inline-block;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: 24rpx;
  padding: 6rpx 18rpx;
  border-radius: 100rpx;
}

.slot-line {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.slot-day {
  width: 120rpx;
  font-size: 27rpx;
  color: var(--color-text);
  flex-shrink: 0;
}

.slot-time {
  font-size: 27rpx;
  color: var(--color-text-secondary);
}

/* ---------- 可视化网格 ---------- */
.legend {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin: 16rpx 0 20rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.legend-swatch {
  width: 24rpx;
  height: 24rpx;
  border-radius: 6rpx;
  margin-right: 8rpx;
}

.legend-free { background: #2bb673; }
.legend-clash { background: #c6cad0; }
.legend-mine { background: #3a7afe; }
.legend-theirs { background: #f5a623; }

.week-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.week-nav-btn {
  width: 72rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 40rpx;
  color: var(--color-primary);
  background: var(--color-primary-soft);
  border-radius: 12rpx;
}

.week-nav-disabled {
  color: var(--color-text-tertiary);
  background: var(--color-bg);
}

.week-nav-label {
  min-width: 160rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text);
}

.match-grid {
  overflow: hidden;
  border-top: 1rpx solid var(--color-border);
  border-right: 1rpx solid var(--color-border);
}

.mg-row {
  display: flex;
}

.mg-slot-label {
  width: 96rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  padding: 4rpx 8rpx;
  box-sizing: border-box;
  border-left: 1rpx solid var(--color-border);
}

.mg-slot-no {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.mg-slot-time {
  font-size: 18rpx;
  color: var(--color-text-tertiary);
}

.mg-day {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.mg-day-head {
  height: 56rpx;
  font-size: 22rpx;
  color: var(--color-text);
}

.mg-cell {
  border-left: 1rpx solid var(--color-border);
  border-bottom: 1rpx solid var(--color-border);
  box-sizing: border-box;
}

.mg-cell-label {
  font-size: 20rpx;
}

.cell-free { background: #e6f7ec; }
.cell-clash { background: #eef0f2; }
.cell-clash .mg-cell-label { color: #9aa0a6; }
.cell-mine { background: #eaf1ff; }
.cell-mine .mg-cell-label { color: #3a7afe; }
.cell-theirs { background: #fff4e5; }
.cell-theirs .mg-cell-label { color: #b97a1f; }
.cell-out { background: transparent; }

.mg-break {
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  background: var(--color-bg);
  border-bottom: 1rpx solid var(--color-border);
  border-left: 1rpx solid var(--color-border);
}

.free-list {
  margin-top: 28rpx;
  border-top: 1rpx dashed var(--color-border);
  padding-top: 20rpx;
}

.free-list-title {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}
