.match-page {
  padding-bottom: 60rpx;
}

.code-row {
  display: flex;
  align-items: center;
}

.code-input {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--color-bg);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  letter-spacing: 6rpx;
  text-transform: uppercase;
  box-sizing: border-box;
}

.align-btn {
  width: 220rpx;
  margin-left: 20rpx;
  flex-shrink: 0;
}

.range-row {
  display: flex;
  margin-top: 28rpx;
}

.range-item {
  flex: 1;
  margin-right: 20rpx;
}

.range-item:last-child {
  margin-right: 0;
}

.range-label {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 10rpx;
}

.picker.small {
  height: 76rpx;
  line-height: 76rpx;
  font-size: 26rpx;
}

.hint {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-top: 20rpx;
}

/* ---------- 兜底提示 ---------- */
.tip-box {
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.tip-empty {
  background: #fff7e8;
}

.tip-none {
  background: #eef3ff;
}

.tip-error {
  background: #fff1f0;
}

.tip-text {
  display: block;
  font-size: 27rpx;
  color: var(--color-text);
  line-height: 1.6;
}

.tip-action {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--color-primary);
  min-height: 60rpx;
  line-height: 60rpx;
}

/* ---------- 结果区 ---------- */
.week-group {
  margin-bottom: 28rpx;
}

.week-group-head {
  margin-bottom: 14rpx;
}

.week-badge {
  display: inline-block;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: 24rpx;
  padding: 6rpx 18rpx;
  border-radius: 100rpx;
}

.slot-line {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.slot-day {
  width: 120rpx;
  font-size: 27rpx;
  color: var(--color-text);
  flex-shrink: 0;
}

.slot-time {
  font-size: 27rpx;
  color: var(--color-text-secondary);
}
