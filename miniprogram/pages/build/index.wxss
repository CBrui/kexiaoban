.build-page {
  padding-bottom: 60rpx;
}

/* ---------- 入口切换 ---------- */
.tabs {
  display: flex;
  background: var(--color-surface);
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  min-height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  border-radius: 12rpx;
}

.tab-active {
  background: var(--color-primary);
  color: #ffffff;
}

/* ---------- 表单字段 ---------- */
.field {
  margin-bottom: 28rpx;
}

.field-row {
  display: flex;
}

.field.half {
  flex: 1;
  margin-right: 20rpx;
}

.field.half:last-child {
  margin-right: 0;
}

.label {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}

.required {
  color: var(--color-danger);
}

.input,
.picker {
  height: 84rpx;
  line-height: 84rpx;
  background: var(--color-bg);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--color-text);
  box-sizing: border-box;
}

.hint {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-top: 10rpx;
}

.submit-btn {
  margin-top: 12rpx;
}

/* ---------- 对话区 ---------- */
.dialog-input {
  width: 100%;
  min-height: 200rpx;
  background: var(--color-bg);
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.dialog-actions {
  display: flex;
  margin-top: 24rpx;
}

.dialog-btn {
  flex: 1;
  margin: 0 8rpx;
}

.parse-error {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #a3202b;
  background: #fff1f0;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}

/* 流式解析进度（打字机提示） */
.stream-hint {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--color-primary);
  background: var(--color-primary-soft);
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
}

/* AI 生成标识：过审需要，不能省 */
.ai-notice {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  line-height: 1.5;
}

/* ---------- 识别模式开关 ---------- */
.opt-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--color-border);
}

.opt-label {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
}

.opt-title {
  font-size: 28rpx;
  color: var(--color-text);
}

.opt-desc {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  line-height: 1.4;
}

/* ---------- 解析结果 ---------- */

/* 课表版式规则提示：周次最容易漏，把「周次写在哪」显式说出来 */
.layout-hint {
  margin: 8rpx 0 12rpx;
  padding: 12rpx 16rpx;
  border-radius: 10rpx;
  background: rgba(58, 122, 254, 0.08);
  font-size: 22rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.layout-evidence {
  color: var(--color-text-tertiary);
}

.parsed-item {
  border: 1rpx solid var(--color-border);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.parsed-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.parsed-index {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
}

.parsed-remove {
  font-size: 24rpx;
  color: var(--color-danger);
  padding: 8rpx 16rpx;
}

.missing-tag {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #a35b00;
  background: #fff7e8;
  border-radius: 8rpx;
  padding: 10rpx 16rpx;
}

/* 解析来源标识（AI 解析 / 本地识别） */
.source-badge {
  display: inline-block;
  margin-left: 12rpx;
  font-size: 20rpx;
  font-weight: 400;
  color: var(--color-primary);
  background: var(--color-primary-soft);
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
  vertical-align: middle;
}

.missing-field {
  margin-right: 12rpx;
}

/* ---------- 拍照导入 ---------- */

/* 识别预期提示：如实告知不同来源的识别效果 */
.expect-list {
  background: var(--color-bg);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.expect-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}

.expect-src {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.expect-lv {
  font-size: 22rpx;
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
}

.expect-high {
  color: #1a7f37;
  background: #e8f5ec;
}

.expect-mid {
  color: #a35b00;
  background: #fff7e8;
}

.expect-low {
  color: #a3202b;
  background: #fff1f0;
}

.image-preview {
  position: relative;
  margin-bottom: 24rpx;
}

.image-thumb {
  width: 100%;
  height: 320rpx;
  border-radius: 12rpx;
  background: var(--color-bg);
}

.image-clear {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  font-size: 22rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 24rpx;
  padding: 8rpx 20rpx;
}

/* 未选图时禁用「开始识别」的观感 */
.btn-disabled {
  opacity: 0.5;
}

/* ============ 调课（补课 / 换课 / 挪课 / 停课） ============ */

/* 调课说法举例：可点击直接填入并解析 */
.shift-tips {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 16rpx;
}

.shift-tips-title {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-right: 8rpx;
}

.shift-tip {
  font-size: 22rpx;
  color: var(--color-primary);
  background: var(--color-primary-soft);
  border-radius: 20rpx;
  padding: 8rpx 18rpx;
  margin: 6rpx 8rpx 0 0;
}

/* 单条调课计划 */
.shift-plan {
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
  padding: 20rpx;
  margin-top: 20rpx;
  background: var(--color-bg);
}

.shift-plan-head {
  display: flex;
  align-items: baseline;
}

.shift-action {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
  background: var(--color-primary);
  border-radius: 6rpx;
  padding: 4rpx 14rpx;
  margin-right: 12rpx;
}

.shift-summary {
  flex: 1;
  font-size: 26rpx;
  color: var(--color-text);
  line-height: 1.5;
}

.shift-reason {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #a3202b;
}

/* 冲突提示：必须显眼，否则用户不知道课被叠在一起了 */
.shift-conflict {
  margin-top: 16rpx;
  background: #fff7e8;
  border-radius: 10rpx;
  padding: 14rpx 18rpx;
}

.shift-conflict-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #a35b00;
}

.shift-conflict-row {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #a35b00;
  line-height: 1.5;
}

.shift-block {
  margin-top: 18rpx;
}

.shift-block-title {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.shift-row {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  font-size: 25rpx;
}

.shift-name {
  color: var(--color-text);
  max-width: 240rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shift-detail {
  margin-left: 14rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.shift-tag {
  margin-left: auto;
  flex-shrink: 0;
  font-size: 21rpx;
  color: var(--color-primary);
  background: var(--color-primary-soft);
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
}

.shift-tag.danger {
  color: #a3202b;
  background: #fff1f0;
}

.shift-tip-line {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}
