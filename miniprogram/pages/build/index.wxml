<view class="page build-page">

  <!-- 入口切换 -->
  <view class="tabs">
    <view class="tab {{tab === 'manual' ? 'tab-active' : ''}}" data-tab="manual" bindtap="onSwitchTab">
      <text>手工录入</text>
    </view>
    <view class="tab {{tab === 'dialog' ? 'tab-active' : ''}}" data-tab="dialog" bindtap="onSwitchTab">
      <text>对话建表</text>
    </view>
    <view class="tab {{tab === 'image' ? 'tab-active' : ''}}" data-tab="image" bindtap="onSwitchTab">
      <text>拍照导入</text>
    </view>
  </view>

  <!-- ============ 手工录入 ============ -->
  <view wx:if="{{tab === 'manual'}}" class="card">
    <view class="field">
      <text class="label">课程名称 <text class="required">*</text></text>
      <input class="input" placeholder="如：高等数学" value="{{form.name}}" data-field="name" bindinput="onInput" />
    </view>

    <view class="field-row">
      <view class="field half">
        <text class="label">教师</text>
        <input class="input" placeholder="王老师" value="{{form.teacher}}" data-field="teacher" bindinput="onInput" />
      </view>
      <view class="field half">
        <text class="label">地点</text>
        <input class="input" placeholder="A301" value="{{form.location}}" data-field="location" bindinput="onInput" />
      </view>
    </view>

    <view class="field">
      <text class="label">星期</text>
      <picker mode="selector" range="{{dayLabels}}" value="{{form.dayIndex}}" bindchange="onPickDay">
        <view class="picker">{{dayLabels[form.dayIndex]}}</view>
      </picker>
    </view>

    <view class="field-row">
      <view class="field half">
        <text class="label">开始节次</text>
        <picker mode="selector" range="{{slotOptions}}" value="{{form.startSlot - 1}}" bindchange="onPickStartSlot">
          <view class="picker">第 {{form.startSlot}} 节</view>
        </picker>
      </view>
      <view class="field half">
        <text class="label">连续节数</text>
        <picker mode="selector" range="{{slotOptions}}" value="{{form.slotCount - 1}}" bindchange="onPickSlotCount">
          <view class="picker">{{form.slotCount}} 节</view>
        </picker>
      </view>
    </view>

    <view class="field">
      <text class="label">周次范围</text>
      <input class="input" placeholder="1-16 或 1-16 单" value="{{form.weeks}}" data-field="weeks" bindinput="onInput" />
      <text class="hint">支持：1-16 / 1-16 单 / 1-16 双 / 3,5,7 / 1-8,10-16</text>
    </view>

    <view class="btn btn-primary submit-btn" bindtap="onSubmitManual">添加课程</view>
  </view>

  <!-- ============ 对话建表 ============ -->
  <view wx:if="{{tab === 'dialog'}}">
    <view class="card">
      <view class="section-title">一句话说清你的课</view>
      <textarea
        class="dialog-input"
        placeholder="例如：周一三四节高等数学，王老师，A301；周三一二节英语，李老师，B203"
        value="{{dialogText}}"
        bindinput="onDialogInput"
        maxlength="500"
        auto-height
      ></textarea>
      <!-- 调课说法举例：告诉用户这里还能改课表，而不是只能加课 -->
      <view class="shift-tips">
        <text class="shift-tips-title">也可以直接说调课：</text>
        <text class="shift-tip" bindtap="onUseShiftExample" data-text="今天补上周二的课">今天补上周二的课</text>
        <text class="shift-tip" bindtap="onUseShiftExample" data-text="今天换成上周二的课">今天换成上周二的课</text>
        <text class="shift-tip" bindtap="onUseShiftExample" data-text="今天只补上周二的34节">今天只补上周二的34节</text>
      </view>
      <view class="dialog-actions">
        <view class="btn btn-ghost dialog-btn" bindtap="onUseExample">用示例</view>
        <view class="btn btn-primary dialog-btn" bindtap="onParse">{{parsing ? '解析中…' : '开始解析'}}</view>
      </view>
      <view wx:if="{{parsing && streamHint}}" class="stream-hint">{{streamHint}}</view>
      <view wx:if="{{parseError}}" class="parse-error">{{parseError}}</view>
      <view wx:if="{{shiftError}}" class="parse-error">{{shiftError}}</view>
      <!-- 调课执行结果：说明落在哪些周，并给一键去课表核对的入口 -->
      <view wx:if="{{shiftDone}}" class="shift-done">
        <view class="shift-done-title">{{shiftDone}}</view>
        <view wx:if="{{shiftDoneHint}}" class="shift-done-hint">{{shiftDoneHint}}</view>
        <view class="btn btn-ghost shift-done-btn" bindtap="onGoTimetable">去课表看看</view>
      </view>
      <view class="ai-notice">解析由 AI 生成，结果仅供参考，请核对后再写入</view>
    </view>

    <!-- ============ 调课计划预览 ============ -->
    <view wx:if="{{shiftPlans.length}}" class="card">
      <view class="section-title">
        调课计划（{{shiftPlans.length}} 条）
        <text class="source-badge">{{usedAI ? 'AI 解析' : '本地识别'}}</text>
      </view>

      <view class="shift-plan" wx:for="{{shiftPlans}}" wx:key="index">
        <view class="shift-plan-head">
          <text class="shift-action">{{item.actionText}}</text>
          <text class="shift-summary">{{item.summary}}</text>
        </view>

        <view wx:if="{{!item.ok}}" class="shift-reason">{{item.reason}}</view>

        <!-- 冲突必须先看见：补课叠加到已有课上会很乱 -->
        <view wx:if="{{item.conflictList.length}}" class="shift-conflict">
          <text class="shift-conflict-title">⚠️ 节次冲突</text>
          <view class="shift-conflict-row" wx:for="{{item.conflictList}}" wx:for-item="cf" wx:key="index">
            {{cf.name}}（{{cf.slotText}}节）与已有课「{{cf.withName}}」撞了，仍会写入
          </view>
        </view>

        <view wx:if="{{item.removeList.length}}" class="shift-block">
          <text class="shift-block-title">移除 / 调整</text>
          <view class="shift-row" wx:for="{{item.removeList}}" wx:for-item="rm" wx:key="index">
            <text class="shift-name">{{rm.name}}</text>
            <text class="shift-detail">{{rm.slotText}}节</text>
            <text wx:if="{{rm.willDelete}}" class="shift-tag danger">整条删除</text>
            <text wx:else class="shift-tag">周次 {{rm.nextWeeks}}</text>
          </view>
        </view>

        <view wx:if="{{item.addList.length}}" class="shift-block">
          <text class="shift-block-title">新增</text>
          <view class="shift-row" wx:for="{{item.addList}}" wx:for-item="ad" wx:key="index">
            <text class="shift-name">{{ad.name}}</text>
            <text class="shift-detail">{{ad.dayText}} {{ad.slotText}}节</text>
            <text class="shift-tag">第{{ad.weeks}}周</text>
          </view>
        </view>
      </view>

      <view class="shift-tip-line">调课只影响说到的那一天，其他周次的课不受影响</view>
      <view class="dialog-actions">
        <view class="btn btn-ghost dialog-btn" bindtap="onCancelShift">取消</view>
        <view class="btn btn-primary dialog-btn" bindtap="onConfirmShift">确认调课</view>
      </view>
    </view>
  </view>

  <!-- ============ 拍照导入 ============ -->
  <view wx:if="{{tab === 'image'}}">
    <view class="card">
      <view class="section-title">拍一张课表照片</view>

      <!-- 识别预期提示：如实告知不同来源的识别效果，避免用户期望落空 -->
      <view class="expect-list">
        <view class="expect-row">
          <text class="expect-src">教务系统截图</text>
          <text class="expect-lv expect-high">识别率高</text>
        </view>
        <view class="expect-row">
          <text class="expect-src">纸质课表拍照</text>
          <text class="expect-lv expect-mid">识别率中</text>
        </view>
        <view class="expect-row">
          <text class="expect-src">手写课表</text>
          <text class="expect-lv expect-low">识别率低</text>
        </view>
      </view>

      <!-- 识别模式：完整模式先读版式再提课程（周次更准），快速模式跳过版式分析 -->
      <view class="opt-row">
        <view class="opt-label">
          <text class="opt-title">快速识别</text>
          <text class="opt-desc">{{fastMode ? '跳过版式分析，约快 4 秒（周次可能读不到）' : '先分析课表版式再识别，周次更准'}}</text>
        </view>
        <switch checked="{{fastMode}}" bindchange="onToggleFast" color="#3a7afe" />
      </view>

      <!-- 已选图片预览 -->
      <view wx:if="{{imagePath}}" class="image-preview">
        <image class="image-thumb" src="{{imagePath}}" mode="aspectFit" />
        <view class="image-clear" bindtap="onClearImage">重新选择</view>
      </view>

      <view class="dialog-actions">
        <view class="btn btn-ghost dialog-btn" bindtap="onPickImage">选择图片</view>
        <view class="btn btn-primary dialog-btn {{imagePath ? '' : 'btn-disabled'}}" bindtap="onParseImage">
          {{recognizing ? '识别中…' : '开始识别'}}
        </view>
      </view>

      <view wx:if="{{recognizing}}" class="stream-hint">
        {{imageHint}}<text wx:if="{{imageElapsed > 3}}"> 已等待 {{imageElapsed}} 秒，识别较慢请勿退出</text>
      </view>
      <view wx:if="{{imageError}}" class="parse-error">{{imageError}}</view>

      <view class="ai-notice">
        识别由 AI 生成，结果仅供参考，请核对后再写入。图片仅用于本次识别，识别完成后自动删除。
      </view>
    </view>
  </view>

  <!-- ============ 解析结果（对话 / 拍照共用） ============ -->
  <view wx:if="{{(tab === 'dialog' || tab === 'image') && parsed.length}}">
    <view class="card">
      <view class="section-title">
        解析结果（{{parsed.length}} 门），确认后写入
        <text class="source-badge">{{usedAI ? 'AI 解析' : '本地识别'}}</text>
      </view>
      <!-- 课表版式规则：让用户知道周次是从哪儿读出来的（周次最容易漏） -->
      <view wx:if="{{weeksHint}}" class="layout-hint">
        {{weeksHint}}
        <text wx:if="{{weeksEvidence}}" class="layout-evidence">（图上原文：{{weeksEvidence}}）</text>
      </view>
      <view class="parsed-item" wx:for="{{parsed}}" wx:key="index">
        <view class="parsed-head">
          <text class="parsed-index">#{{index + 1}}</text>
          <view class="parsed-remove" data-idx="{{index}}" bindtap="onRemoveParsed">移除</view>
        </view>

        <view class="field">
          <text class="label">课程名</text>
          <input class="input" value="{{item.name}}" data-idx="{{index}}" data-field="name" bindinput="onEditParsed" placeholder="待补充" />
        </view>

        <view class="field-row">
          <view class="field half">
            <text class="label">星期</text>
            <input class="input" type="number" value="{{item.day_of_week}}" data-idx="{{index}}" data-field="day_of_week" bindinput="onEditParsed" placeholder="1-7" />
          </view>
          <view class="field half">
            <text class="label">开始节次</text>
            <input class="input" type="number" value="{{item.start_slot}}" data-idx="{{index}}" data-field="start_slot" bindinput="onEditParsed" placeholder="1-6" />
          </view>
        </view>

        <view class="field-row">
          <view class="field half">
            <text class="label">连续节数</text>
            <input class="input" type="number" value="{{item.slot_count}}" data-idx="{{index}}" data-field="slot_count" bindinput="onEditParsed" />
          </view>
          <view class="field half">
            <text class="label">周次</text>
            <input class="input" value="{{item.weeks}}" data-idx="{{index}}" data-field="weeks" bindinput="onEditParsed" />
          </view>
        </view>

        <view class="field-row">
          <view class="field half">
            <text class="label">教师</text>
            <input class="input" value="{{item.teacher}}" data-idx="{{index}}" data-field="teacher" bindinput="onEditParsed" placeholder="—" />
          </view>
          <view class="field half">
            <text class="label">地点</text>
            <input class="input" value="{{item.location}}" data-idx="{{index}}" data-field="location" bindinput="onEditParsed" placeholder="—" />
          </view>
        </view>

        <view wx:if="{{item.missing_fields.length}}" class="missing-tag">
          待补充：<text wx:for="{{item.missing_fields}}" wx:for-item="mf" wx:key="*this" class="missing-field">{{missingLabel[mf] || mf}} </text>
        </view>
      </view>

      <view class="btn btn-primary submit-btn" bindtap="onConfirmParsed">确认并写入课表</view>
    </view>
  </view>

</view>
