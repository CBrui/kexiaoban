/**
 * app.wxss —— 全局样式与设计变量
 * 规范：可点击区域不小于 44x44px；网格线统一 1rpx
 */
page {
  --color-primary: #3a7afe;
  --color-primary-soft: #eaf1ff;
  --color-text: #1f2329;
  --color-text-secondary: #646a73;
  --color-text-tertiary: #8f959e;
  --color-border: #e5e6eb;
  --color-bg: #f5f6f8;
  --color-surface: #ffffff;
  --color-danger: #f53f3f;
  --radius-md: 12rpx;
  --radius-lg: 20rpx;

  background: var(--color-bg);
  color: var(--color-text);
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx;
}

.card {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-text);
  margin-bottom: 20rpx;
}

.text-secondary {
  color: var(--color-text-secondary);
}

.text-tertiary {
  color: var(--color-text-tertiary);
  font-size: 24rpx;
}

.btn {
  min-height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: var(--radius-md);
  font-size: 30rpx;
}

.btn-primary {
  background: var(--color-primary);
  color: #ffffff;
}

.btn-ghost {
  background: var(--color-surface);
  color: var(--color-primary);
  border: 1rpx solid var(--color-primary);
}

.empty-tip {
  padding: 80rpx 40rpx;
  text-align: center;
  color: var(--color-text-tertiary);
  font-size: 26rpx;
}
